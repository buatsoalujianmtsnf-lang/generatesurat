{
  "schemaVersion": 1,
  "feature": "first-party-sponsor-video",
  "enabled": false,
  "releasePhase": "prelaunch",
  "exportActions": [
    "print",
    "pdf",
    "keyboard-print"
  ],
  "frequency": "every-new-action",
  "video": {
    "requiredDurationSeconds": 15,
    "durationToleranceSeconds": 0.12,
    "playbackRate": 1,
    "skippable": false,
    "clickRequired": false,
    "firstPartyOnly": true,
    "mediaRoot": "assets/sponsors/",
    "allowedFormats": {
      "video/mp4": ".mp4",
      "video/webm": ".webm"
    },
    "allowedVideoCodecs": {
      "video/mp4": [
        "h264"
      ],
      "video/webm": [
        "vp8",
        "vp9"
      ]
    },
    "maxBytes": 10485760,
    "maxWidth": 1920,
    "maxHeight": 1080,
    "captionRequiredWhenSpeech": true
  },
  "eligibility": {
    "requiredApprovals": [
      "agreementSigned",
      "rightsVerified",
      "contentApproved",
      "privacyApproved",
      "operatorApproved"
    ],
    "noUserTargeting": true,
    "noThirdPartyPixels": true,
    "noDocumentData": true,
    "noForcedClicks": true,
    "audience": "education-including-minors",
    "requirePublisherDisclosure": true,
    "prohibitedCategories": [
      "gambling",
      "adult",
      "nicotine",
      "alcohol",
      "illegal-drugs",
      "weapons",
      "misleading-claims",
      "political-campaigns",
      "unsafe-credit-products"
    ]
  },
  "behavior": {
    "failClosedBeforeLaunch": true,
    "pdfServerVerificationRequired": true,
    "printBrowserBestEffort": true,
    "autoplayFallbackRequired": true,
    "pauseAndCaptionsRequired": true,
    "noVideoInsideExport": true
  },
  "policySources": [
    "https://support.google.com/adsense/answer/48182?hl=id",
    "https://support.google.com/adsense/answer/1346295?hl=en",
    "https://peraturan.bpk.go.id/Details/229798/uu-no-27-"
  ]
}
