{
  "name": "generator-surat",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm run check:syntax && npm run check:types && npm run check:sponsor && npm run check:mon07 && npm test",
    "check:types": "tsc --project tsconfig.json --noEmit --pretty false",
    "check:sponsor": "node scripts/validate-sponsor-campaigns.js",
    "test:mon07:redis": "node scripts/mon07-redis-integration.js",
    "test:mon07:browser": "node scripts/mon07-browser-smoke.js",
    "check:mon07": "node scripts/mon07-release-readiness.js --expect-blocked"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.1.0",
    "typescript": "5.8.3",
    "@types/node": "22.15.30"
  }
}
